Subject: [PATCH] screencast: restore window sessions (toplevel_identifier)

Session restore (persist_mode/restore_data) only covers monitors:
restore_data carries "output_name" and nothing is returned when a window
was shared. Chromium-based apps (Vesktop, Chrome...) start a capture twice
or three times for one share (the preview of their own settings dialog and
the actual stream; see https://issues.chromium.org/issues/354537406) and
rely on the restore token to skip the chooser on the follow-up requests,
so sharing a window asks two or three times.

Return restore_data with "toplevel_identifier" (the ext-foreign-toplevel
identifier, stable for the lifetime of the window) when a window was
selected, and accept it in SelectSources: if that window still exists it
is selected without running the chooser; otherwise the chooser runs as
before. Monitors are unchanged. Still requires persist_mode, i.e.
XDPW_PERSIST_MODE in the environment.
---
diff --git a/include/screencast_common.h b/include/screencast_common.h
--- a/include/screencast_common.h
+++ b/include/screencast_common.h
@@ -149,6 +149,7 @@
 struct xdpw_screencast_restore_data {
 	uint32_t version;
 	const char *output_name;
+	const char *toplevel_identifier;
 };
 
 struct xdpw_format_modifier_pair {
diff --git a/src/screencast/screencast.c b/src/screencast/screencast.c
--- a/src/screencast/screencast.c
+++ b/src/screencast/screencast.c
@@ -437,6 +437,10 @@
 					if (strcmp(rdKey, "output_name") == 0) {
 						sd_bus_message_read(msg, "v", "s", &restore_data.output_name);
 						logprint(INFO, "dbus: option restore_data.output_name: %s", restore_data.output_name);
+					} else if (strcmp(rdKey, "toplevel_identifier") == 0) {
+						sd_bus_message_read(msg, "v", "s", &restore_data.toplevel_identifier);
+						logprint(INFO, "dbus: option restore_data.toplevel_identifier: %s",
+							restore_data.toplevel_identifier);
 					} else {
 						logprint(WARN, "dbus: unknown option %s", rdKey);
 						sd_bus_message_skip(msg, "v");
@@ -698,6 +702,17 @@
 		if (ret < 0) {
 			return ret;
 		}
+	} else if (sess->screencast_data.persist_mode != PERSIST_NONE && cast->target->toplevel &&
+			cast->target->toplevel->identifier) {
+		// Windows: the ext-foreign-toplevel identifier is stable for the lifetime of the window,
+		// so a restored session gets the same window (or falls back to the chooser if it's gone).
+		ret = sd_bus_message_append(reply, "{sv}",
+			"restore_data", "(suv)",
+			"wlroots", XDP_CAST_DATA_VER,
+			"a{sv}", 1, "toplevel_identifier", "s", cast->target->toplevel->identifier);
+		if (ret < 0) {
+			return ret;
+		}
 	}
 
 	ret = sd_bus_message_close_container(reply);
diff --git a/src/screencast/wlr_screencast.c b/src/screencast/wlr_screencast.c
--- a/src/screencast/wlr_screencast.c
+++ b/src/screencast/wlr_screencast.c
@@ -173,15 +173,29 @@
 
 bool xdpw_wlr_target_from_data(struct xdpw_screencast_context *ctx, struct xdpw_screencast_target *target,
 		struct xdpw_screencast_restore_data *data) {
-	struct xdpw_wlr_output *out = NULL;
-	out = xdpw_wlr_output_find_by_name(&ctx->output_list, data->output_name);
+	if (data->output_name) {
+		struct xdpw_wlr_output *out = NULL;
+		out = xdpw_wlr_output_find_by_name(&ctx->output_list, data->output_name);
 
-	if (!out) {
-		return false;
+		if (!out) {
+			return false;
+		}
+		target->type = MONITOR;
+		target->output = out;
+		return true;
 	}
-	target->type = MONITOR;
-	target->output = out;
-	return true;
+	if (data->toplevel_identifier) {
+		struct xdpw_toplevel *toplevel;
+		wl_list_for_each(toplevel, &ctx->toplevels, link) {
+			if (toplevel->identifier &&
+					strcmp(toplevel->identifier, data->toplevel_identifier) == 0) {
+				target->type = WINDOW;
+				target->toplevel = toplevel;
+				return true;
+			}
+		}
+	}
+	return false;
 }
 
 static void wlr_remove_output(struct xdpw_wlr_output *out) {
