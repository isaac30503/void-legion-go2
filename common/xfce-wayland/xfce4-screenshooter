#!/bin/sh
# xfce4-screenshooter — transparent wrapper for Xfce Screenshooter under Wayland.
# 1. Always sends captured screenshots to the Wayland clipboard via wl-copy.
# 2. Handles active-window capture (-w / --window) under mangowc by querying
#    window geometry via mango IPC (mmsg) and cropping the capture.
# 3. Handles full-screen capture (-f / --fullscreen or default Print) by capturing
#    the ACTIVE MONITOR (where the focused window / cursor is) instead of stitching
#    all connected monitors into a single image.
# Installed in ~/.local/bin/xfce4-screenshooter by common/xfce-wayland/install-xfce-wayland.sh (docs/5-desktop/1-xfce.md).
set -u

# Ensure Wayland environment variables if missing from spawn environment
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR}/wayland-0" ]; then
    export WAYLAND_DISPLAY="wayland-0"
fi

# Locate mango IPC socket if available
MANGO_SOCK="${MANGO_INSTANCE_SIGNATURE:-}"
if [ -z "$MANGO_SOCK" ]; then
    for s in "${XDG_RUNTIME_DIR}"/mango-*.sock; do
        if [ -S "$s" ]; then MANGO_SOCK="$s"; break; fi
    done
fi

# Parse arguments: track custom save path, window capture (-w), fullscreen (-f), or region (-r)
CUSTOM_TARGET=""
IS_WINDOW=false
IS_REGION=false
IS_FULLSCREEN=false
prev=""

if [ $# -eq 0 ]; then
    IS_FULLSCREEN=true
fi

for arg in "$@"; do
    if [ "$prev" = "-s" ] || [ "$prev" = "--save" ]; then
        CUSTOM_TARGET="$arg"
    fi
    case "$arg" in
        -w|--window)     IS_WINDOW=true ;;
        -r|--region)     IS_REGION=true ;;
        -f|--fullscreen) IS_FULLSCREEN=true ;;
    esac
    prev="$arg"
done

# Default screenshot directory from Xfce Screenshooter config
CONF_DIR=""
if [ -f "$HOME/.config/xfce4/xfce4-screenshooter" ]; then
    URI=$(grep "^screenshot_dir=" "$HOME/.config/xfce4/xfce4-screenshooter" 2>/dev/null | cut -d= -f2- || true)
    case "$URI" in
        file://*) CONF_DIR="${URI#file://}" ;;
        file:*)   CONF_DIR="${URI#file:}" ;;
    esac
fi
if [ -z "$CONF_DIR" ] || [ ! -d "$CONF_DIR" ]; then
    CONF_DIR="$HOME/Imágenes"
    [ -d "$CONF_DIR" ] || CONF_DIR="$HOME"
fi

# --- Helper to resolve target filename ---
resolve_target() {
    if [ -n "$CUSTOM_TARGET" ]; then
        if [ -d "$CUSTOM_TARGET" ]; then
            echo "$CUSTOM_TARGET/Captura de pantalla_$(date +%Y-%m-%d_%H-%M-%S).png"
        else
            echo "$CUSTOM_TARGET"
        fi
    else
        echo "$CONF_DIR/Captura de pantalla_$(date +%Y-%m-%d_%H-%M-%S).png"
    fi
}

# --- Mode 1: Active Window Capture under mango ---
if [ "$IS_WINDOW" = "true" ] && [ -n "$MANGO_SOCK" ] && command -v mmsg >/dev/null 2>&1 && command -v convert >/dev/null 2>&1; then
    GEOM=$(MANGO_INSTANCE_SIGNATURE="$MANGO_SOCK" mmsg get focusing-client 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    if d.get("width", 0) > 0 and d.get("height", 0) > 0:
        print("%dx%d+%d+%d" % (d["width"], d["height"], d["x"], d["y"]))
except Exception:
    pass
' 2>/dev/null || true)

    if [ -n "$GEOM" ]; then
        TMP_FULL=$(mktemp /tmp/.screenshot-full.XXXXXX.png)
        if /usr/bin/xfce4-screenshooter -f -s "$TMP_FULL" >/dev/null 2>&1; then
            OUT_FILE=$(resolve_target)
            convert "$TMP_FULL" -crop "$GEOM" +repage "$OUT_FILE"
            rm -f "$TMP_FULL"
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy -t image/png < "$OUT_FILE" 2>/dev/null || true
            fi
            exit 0
        fi
        rm -f "$TMP_FULL"
    fi
fi

# --- Mode 2: Active Monitor Capture (Print key / -f) under mango ---
if [ "$IS_FULLSCREEN" = "true" ] && [ "$IS_REGION" = "false" ] && [ "$IS_WINDOW" = "false" ] && [ -n "$MANGO_SOCK" ] && command -v mmsg >/dev/null 2>&1 && command -v convert >/dev/null 2>&1; then
    MON_GEOM=$(MANGO_INSTANCE_SIGNATURE="$MANGO_SOCK" mmsg get all-monitors 2>/dev/null | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    mons = data.get("monitors", [])
    active = next((m for m in mons if m.get("active")), mons[0] if mons else None)
    if active and active.get("width", 0) > 0 and active.get("height", 0) > 0:
        print("%dx%d+%d+%d" % (active["width"], active["height"], active["x"], active["y"]))
except Exception:
    pass
' 2>/dev/null || true)

    if [ -n "$MON_GEOM" ]; then
        TMP_FULL=$(mktemp /tmp/.screenshot-full.XXXXXX.png)
        if /usr/bin/xfce4-screenshooter -f -s "$TMP_FULL" >/dev/null 2>&1; then
            OUT_FILE=$(resolve_target)
            convert "$TMP_FULL" -crop "$MON_GEOM" +repage "$OUT_FILE"
            rm -f "$TMP_FULL"
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy -t image/png < "$OUT_FILE" 2>/dev/null || true
            fi
            exit 0
        fi
        rm -f "$TMP_FULL"
    fi
fi

# --- Mode 3: Standard execution with transparent clipboard capture (e.g. -r region) ---
# If invoked with no args and mango IPC was not available, default to -f
if [ $# -eq 0 ]; then
    set -- -f
fi

REF=$(mktemp /tmp/.screenshooter-ref.XXXXXX)

/usr/bin/xfce4-screenshooter "$@"
RET=$?

if [ $RET -ne 0 ]; then
    rm -f "$REF"
    exit $RET
fi

CUSTOM_DIR=""
if [ -n "$CUSTOM_TARGET" ]; then
    if [ -d "$CUSTOM_TARGET" ]; then
        CUSTOM_DIR="$CUSTOM_TARGET"
    else
        CUSTOM_DIR="$(dirname "$CUSTOM_TARGET")"
    fi
fi

CANDIDATE=""
for d in "$CUSTOM_DIR" "$CONF_DIR" "$HOME/Imágenes" "$HOME/Pictures" /tmp; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    FOUND=$(find "$d" -maxdepth 1 -type f -newer "$REF" \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)
    if [ -n "$FOUND" ]; then
        CANDIDATE="$FOUND"
        break
    fi
done

rm -f "$REF"

if [ -n "$CANDIDATE" ] && [ -f "$CANDIDATE" ] && command -v wl-copy >/dev/null 2>&1; then
    MIME="image/png"
    case "$CANDIDATE" in
        *.jpg|*.jpeg) MIME="image/jpeg" ;;
        *.webp)       MIME="image/webp" ;;
    esac
    wl-copy -t "$MIME" < "$CANDIDATE" 2>/dev/null || true
fi

exit $RET
