#!/bin/sh
# xfce4-screenshooter — transparent wrapper for Xfce Screenshooter under Wayland.
# 1. Always copies captured screenshots to the Wayland clipboard via wl-copy.
# 2. Handles active-window capture (-w / --window) under mangowc by querying
#    window geometry via mango IPC (mmsg) and cropping the capture.
# 3. Handles full-screen capture (-f / --fullscreen or default Print) by capturing
#    the ACTIVE MONITOR (where the focused window / cursor is).
# 4. Presents the standard action dialog (Save / Open With / Only Clipboard)
#    with image preview whenever an action wasn't explicitly silenced via CLI.
# Installed in ~/.local/bin/xfce4-screenshooter by common/xfce-wayland/install-xfce-wayland.sh (docs/5-desktop/1-xfce.md).
set -u

# Ensure Wayland environment variables if missing from spawn environment
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR}/wayland-0" ]; then
    export WAYLAND_DISPLAY="wayland-0"
fi

# Locate mango IPC socket if available
MANGO_SOCK="${MANGO_INSTANCE_SIGNATURE:-}"
if [ -z "$MANGO_SOCK" ]; then
    for s in "${XDG_RUNTIME_DIR}"/mango-*.sock; do
        if [ -S "$s" ]; then MANGO_SOCK="$s"; break; fi
    done
fi

# Parse arguments: track custom save path, window capture (-w), fullscreen (-f), or region (-r)
CUSTOM_TARGET=""
IS_WINDOW=false
IS_REGION=false
IS_FULLSCREEN=false
prev=""

if [ $# -eq 0 ]; then
    IS_FULLSCREEN=true
fi

for arg in "$@"; do
    if [ "$prev" = "-s" ] || [ "$prev" = "--save" ]; then
        CUSTOM_TARGET="$arg"
    fi
    case "$arg" in
        -w|--window)     IS_WINDOW=true ;;
        -r|--region)     IS_REGION=true ;;
        -f|--fullscreen) IS_FULLSCREEN=true ;;
    esac
    prev="$arg"
done

# Python helper to display the action dialog (Save / Open with / Clipboard) with thumbnail
show_action_dialog() {
    IMG="$1"
    python3 - "$IMG" "$CUSTOM_TARGET" << 'PYEOF'
import sys, os, gi, subprocess, urllib.parse, datetime
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GdkPixbuf, Gio

def run():
    tmp_img = sys.argv[1]
    custom_target = sys.argv[2] if len(sys.argv) > 2 else ""

    # If an explicit destination file/dir was given on CLI, save directly
    if custom_target:
        if os.path.isdir(custom_target):
            dest = os.path.join(custom_target, f"Captura de pantalla_{datetime.datetime.now().strftime('%Y-%m-%d_%H-%M-%S')}.png")
        else:
            dest = custom_target
        os.replace(tmp_img, dest)
        return

    # Read config for default dir
    conf_file = os.path.expanduser("~/.config/xfce4/xfce4-screenshooter")
    save_dir = os.path.expanduser("~/Imágenes")
    if os.path.exists(conf_file):
        try:
            with open(conf_file, "r") as f:
                for line in f:
                    if line.startswith("screenshot_dir="):
                        uri = line.strip().split("=", 1)[1]
                        if uri.startswith("file://"):
                            save_dir = urllib.parse.unquote(uri[7:])
                        elif uri.startswith("file:"):
                            save_dir = urllib.parse.unquote(uri[5:])
        except Exception:
            pass

    dlg = Gtk.Dialog(title="Captura de pantalla", flags=0)
    dlg.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Aceptar", Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)
    dlg.set_resizable(False)
    dlg.set_position(Gtk.WindowPosition.CENTER)

    box = dlg.get_content_area()
    grid = Gtk.Grid(column_spacing=24, row_spacing=12, margin=16)
    box.add(grid)

    # Actions column
    vbox_actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    lbl_action = Gtk.Label(xalign=0)
    lbl_action.set_markup("<b>Acción</b>")
    vbox_actions.pack_start(lbl_action, False, False, 0)

    r_save = Gtk.RadioButton.new_with_label(None, "Guardar")
    r_open = Gtk.RadioButton.new_with_label_from_widget(r_save, "Abrir con...")
    r_clip = Gtk.RadioButton.new_with_label_from_widget(r_save, "Solo copiar al portapapeles")

    vbox_actions.pack_start(r_save, False, False, 0)

    # Save details
    hbox_dir = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, margin_start=20)
    lbl_dest = Gtk.Label(label="Carpeta:", xalign=0)
    btn_dir = Gtk.FileChooserButton(title="Seleccionar carpeta de destino", action=Gtk.FileChooserAction.SELECT_FOLDER)
    btn_dir.set_current_folder(save_dir if os.path.isdir(save_dir) else os.path.expanduser("~"))
    hbox_dir.pack_start(lbl_dest, False, False, 0)
    hbox_dir.pack_start(btn_dir, True, True, 0)
    vbox_actions.pack_start(hbox_dir, False, False, 0)

    vbox_actions.pack_start(r_open, False, False, 0)

    # Open with combo
    app_store = Gtk.ListStore(str, object)
    apps = Gio.AppInfo.get_all_for_type("image/png")
    for app in apps:
        app_store.append([app.get_display_name(), app])

    combo_open = Gtk.ComboBox.new_with_model(app_store)
    renderer = Gtk.CellRendererText()
    combo_open.pack_start(renderer, True)
    combo_open.add_attribute(renderer, "text", 0)
    if len(app_store) > 0:
        combo_open.set_active(0)
    combo_open.set_margin_start(20)
    combo_open.set_sensitive(False)
    vbox_actions.pack_start(combo_open, False, False, 0)

    vbox_actions.pack_start(r_clip, False, False, 0)

    def on_toggle(b):
        hbox_dir.set_sensitive(r_save.get_active())
        combo_open.set_sensitive(r_open.get_active())

    r_save.connect("toggled", on_toggle)
    r_open.connect("toggled", on_toggle)
    r_clip.connect("toggled", on_toggle)

    grid.attach(vbox_actions, 0, 0, 1, 1)

    # Preview column
    vbox_prev = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    lbl_prev = Gtk.Label(xalign=0)
    lbl_prev.set_markup("<b>Vista previa</b>")
    vbox_prev.pack_start(lbl_prev, False, False, 0)

    try:
        pix = GdkPixbuf.Pixbuf.new_from_file(tmp_img)
        scale = 220.0 / max(pix.get_width(), pix.get_height())
        w = max(1, int(pix.get_width() * min(1.0, scale)))
        h = max(1, int(pix.get_height() * min(1.0, scale)))
        thumb = pix.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)
        img_widget = Gtk.Image.new_from_pixbuf(thumb)
        vbox_prev.pack_start(img_widget, True, True, 0)
    except Exception:
        pass

    grid.attach(vbox_prev, 1, 0, 1, 1)

    dlg.show_all()
    resp = dlg.run()

    chosen_action = "cancel"
    target_folder = btn_dir.get_filename() or save_dir
    selected_app = None
    if resp == Gtk.ResponseType.OK:
        if r_save.get_active():
            chosen_action = "save"
        elif r_open.get_active():
            chosen_action = "open"
            tree_iter = combo_open.get_active_iter()
            if tree_iter:
                selected_app = app_store.get_value(tree_iter, 1)
        else:
            chosen_action = "clip"

    dlg.destroy()

    if chosen_action == "cancel":
        if os.path.exists(tmp_img): os.remove(tmp_img)
        sys.exit(0)

    now_str = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    final_file = os.path.join(target_folder, f"Captura de pantalla_{now_str}.png")

    if chosen_action == "save":
        os.replace(tmp_img, final_file)
        if os.path.exists(conf_file):
            try:
                lines = []
                with open(conf_file, "r") as f:
                    for l in f:
                        if l.startswith("screenshot_dir="):
                            lines.append(f"screenshot_dir=file://{target_folder}\n")
                        else:
                            lines.append(l)
                with open(conf_file, "w") as f:
                    f.writelines(lines)
            except Exception:
                pass
    elif chosen_action == "open":
        os.replace(tmp_img, final_file)
        if selected_app:
            files = [Gio.File.new_for_path(final_file)]
            selected_app.launch(files, None)
    elif chosen_action == "clip":
        if os.path.exists(tmp_img): os.remove(tmp_img)

if __name__ == "__main__":
    run()
PYEOF
}

# --- Mode 1: Active Window Capture under mango ---
if [ "$IS_WINDOW" = "true" ] && [ -n "$MANGO_SOCK" ] && command -v mmsg >/dev/null 2>&1 && command -v convert >/dev/null 2>&1; then
    GEOM=$(MANGO_INSTANCE_SIGNATURE="$MANGO_SOCK" mmsg get focusing-client 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    if d.get("width", 0) > 0 and d.get("height", 0) > 0:
        print("%dx%d+%d+%d" % (d["width"], d["height"], d["x"], d["y"]))
except Exception:
    pass
' 2>/dev/null || true)

    if [ -n "$GEOM" ]; then
        TMP_FULL=$(mktemp /tmp/.screenshot-full.XXXXXX.png)
        if /usr/bin/xfce4-screenshooter -f -s "$TMP_FULL" >/dev/null 2>&1; then
            TMP_WIN=$(mktemp /tmp/.screenshot-win.XXXXXX.png)
            convert "$TMP_FULL" -crop "$GEOM" +repage "$TMP_WIN"
            rm -f "$TMP_FULL"

            # Always copy to Wayland clipboard
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy -t image/png < "$TMP_WIN" 2>/dev/null || true
            fi

            # Show Action Dialog (Save / Open with / Only clipboard)
            show_action_dialog "$TMP_WIN"
            exit 0
        fi
        rm -f "$TMP_FULL"
    fi
fi

# --- Mode 2: Active Monitor Capture (Print key / -f) under mango ---
if [ "$IS_FULLSCREEN" = "true" ] && [ "$IS_REGION" = "false" ] && [ "$IS_WINDOW" = "false" ] && [ -n "$MANGO_SOCK" ] && command -v mmsg >/dev/null 2>&1 && command -v convert >/dev/null 2>&1; then
    MON_GEOM=$(MANGO_INSTANCE_SIGNATURE="$MANGO_SOCK" mmsg get all-monitors 2>/dev/null | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    mons = data.get("monitors", [])
    active = next((m for m in mons if m.get("active")), mons[0] if mons else None)
    if active and active.get("width", 0) > 0 and active.get("height", 0) > 0:
        print("%dx%d+%d+%d" % (active["width"], active["height"], active["x"], active["y"]))
except Exception:
    pass
' 2>/dev/null || true)

    if [ -n "$MON_GEOM" ]; then
        TMP_FULL=$(mktemp /tmp/.screenshot-full.XXXXXX.png)
        if /usr/bin/xfce4-screenshooter -f -s "$TMP_FULL" >/dev/null 2>&1; then
            TMP_MON=$(mktemp /tmp/.screenshot-mon.XXXXXX.png)
            convert "$TMP_FULL" -crop "$MON_GEOM" +repage "$TMP_MON"
            rm -f "$TMP_FULL"

            # Always copy to Wayland clipboard
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy -t image/png < "$TMP_MON" 2>/dev/null || true
            fi

            # Show Action Dialog (Save / Open with / Only clipboard)
            show_action_dialog "$TMP_MON"
            exit 0
        fi
        rm -f "$TMP_FULL"
    fi
fi

# --- Mode 3: Standard execution with transparent clipboard capture (e.g. -r region) ---
if [ $# -eq 0 ]; then
    set -- -f
fi

REF=$(mktemp /tmp/.screenshooter-ref.XXXXXX)

/usr/bin/xfce4-screenshooter "$@"
RET=$?

if [ $RET -ne 0 ]; then
    rm -f "$REF"
    exit $RET
fi

CUSTOM_DIR=""
if [ -n "$CUSTOM_TARGET" ]; then
    if [ -d "$CUSTOM_TARGET" ]; then
        CUSTOM_DIR="$CUSTOM_TARGET"
    else
        CUSTOM_DIR="$(dirname "$CUSTOM_TARGET")"
    fi
fi

CONF_DIR_SEARCH="$HOME/Imágenes"
if [ -f "$HOME/.config/xfce4/xfce4-screenshooter" ]; then
    URI=$(grep "^screenshot_dir=" "$HOME/.config/xfce4/xfce4-screenshooter" 2>/dev/null | cut -d= -f2- || true)
    case "$URI" in
        file://*) CONF_DIR_SEARCH="${URI#file://}" ;;
        file:*)   CONF_DIR_SEARCH="${URI#file:}" ;;
    esac
fi

CANDIDATE=""
for d in "$CUSTOM_DIR" "$CONF_DIR_SEARCH" "$HOME/Imágenes" "$HOME/Pictures" /tmp; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    FOUND=$(find "$d" -maxdepth 1 -type f -newer "$REF" \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)
    if [ -n "$FOUND" ]; then
        CANDIDATE="$FOUND"
        break
    fi
done

rm -f "$REF"

if [ -n "$CANDIDATE" ] && [ -f "$CANDIDATE" ] && command -v wl-copy >/dev/null 2>&1; then
    MIME="image/png"
    case "$CANDIDATE" in
        *.jpg|*.jpeg) MIME="image/jpeg" ;;
        *.webp)       MIME="image/webp" ;;
    esac
    wl-copy -t "$MIME" < "$CANDIDATE" 2>/dev/null || true
fi

exit $RET
