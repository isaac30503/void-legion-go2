#!/bin/sh
# xfce4-screenshooter — transparent wrapper for Xfce Screenshooter under Wayland.
# Unified experience across all capture modes:
# 1. Fullscreen / Active Monitor (Print / -f): captures active monitor via grim or xfce4.
# 2. Window (Ctrl+Print / -w): captures focused window geometry via mango IPC (mmsg).
# 3. Region (Shift+Print / -r): interactive region selection via xfce4-screenshooter.
# 4. Immediate clipboard copy (wl-copy) upon capture.
# 5. Native GTK dialog with preview for ALL modes, defaulting to "Only copy to clipboard",
#    fully translated via void-legion-go2's i18n catalog (messages.po).
# Installed in ~/.local/bin/xfce4-screenshooter by common/xfce-wayland/install-xfce-wayland.sh (docs/5-desktop/1-xfce.md).
set -u

# Ensure Wayland environment variables if missing from spawn environment
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR}/wayland-0" ]; then
    export WAYLAND_DISPLAY="wayland-0"
fi

# Locate mango IPC socket if available
MANGO_SOCK="${MANGO_INSTANCE_SIGNATURE:-}"
if [ -z "$MANGO_SOCK" ]; then
    for s in "${XDG_RUNTIME_DIR}"/mango-*.sock; do
        if [ -S "$s" ]; then MANGO_SOCK="$s"; break; fi
    done
fi

# Parse arguments
CUSTOM_TARGET=""
IS_WINDOW=false
IS_REGION=false
IS_FULLSCREEN=false
prev=""

if [ $# -eq 0 ]; then
    IS_FULLSCREEN=true
fi

for arg in "$@"; do
    if [ "$prev" = "-s" ] || [ "$prev" = "--save" ]; then
        CUSTOM_TARGET="$arg"
    fi
    case "$arg" in
        -w|--window)     IS_WINDOW=true ;;
        -r|--region)     IS_REGION=true ;;
        -f|--fullscreen) IS_FULLSCREEN=true ;;
    esac
    prev="$arg"
done

# Python helper to display the unified action dialog with preview
show_action_dialog() {
    IMG="$1"
    python3 - "$IMG" "$CUSTOM_TARGET" << 'PYEOF'
import sys, os, gi, subprocess, urllib.parse, datetime
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GdkPixbuf, Gio

# Internationalization via void-legion i18n catalog
_ = lambda s: s
for p in [os.path.expanduser("~/.local/share/void-legion/lib"), "/usr/local/share/void-legion/lib"]:
    if os.path.isdir(p):
        sys.path.insert(0, p)
        try:
            from void_legion_i18n import _
            break
        except ImportError:
            pass

def run():
    tmp_img = sys.argv[1]
    custom_target = sys.argv[2] if len(sys.argv) > 2 else ""

    # If an explicit destination file/dir was given on CLI, save directly
    if custom_target:
        if os.path.isdir(custom_target):
            dest = os.path.join(custom_target, f"{_('Screenshot')}_{datetime.datetime.now().strftime('%Y-%m-%d_%H-%M-%S')}.png")
        else:
            dest = custom_target
        os.replace(tmp_img, dest)
        return

    # Read config for default dir
    conf_file = os.path.expanduser("~/.config/xfce4/xfce4-screenshooter")
    save_dir = os.path.expanduser("~/Imágenes")
    if os.path.exists(conf_file):
        try:
            with open(conf_file, "r") as f:
                for line in f:
                    if line.startswith("screenshot_dir="):
                        uri = line.strip().split("=", 1)[1]
                        if uri.startswith("file://"):
                            save_dir = urllib.parse.unquote(uri[7:])
                        elif uri.startswith("file:"):
                            save_dir = urllib.parse.unquote(uri[5:])
        except Exception:
            pass

    dlg = Gtk.Dialog(title=_("Screenshot"), flags=0)
    dlg.add_buttons(_("Cancel"), Gtk.ResponseType.CANCEL, _("OK"), Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)
    dlg.set_resizable(False)
    dlg.set_position(Gtk.WindowPosition.CENTER)

    box = dlg.get_content_area()
    grid = Gtk.Grid(column_spacing=24, row_spacing=12, margin=16)
    box.add(grid)

    # Actions column
    vbox_actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    lbl_action = Gtk.Label(xalign=0)
    lbl_action.set_markup(f"<b>{_('Action')}</b>")
    vbox_actions.pack_start(lbl_action, False, False, 0)

    # Only copy to clipboard selected by default
    r_clip = Gtk.RadioButton.new_with_label(None, _("Only copy to clipboard"))
    r_save = Gtk.RadioButton.new_with_label_from_widget(r_clip, _("Save"))
    r_open = Gtk.RadioButton.new_with_label_from_widget(r_clip, _("Open with..."))

    vbox_actions.pack_start(r_clip, False, False, 0)
    vbox_actions.pack_start(r_save, False, False, 0)

    # Save details
    hbox_dir = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, margin_start=20)
    lbl_dest = Gtk.Label(label=_("Folder:"), xalign=0)
    btn_dir = Gtk.FileChooserButton(title=_("Select destination folder"), action=Gtk.FileChooserAction.SELECT_FOLDER)
    btn_dir.set_current_folder(save_dir if os.path.isdir(save_dir) else os.path.expanduser("~"))
    hbox_dir.pack_start(lbl_dest, False, False, 0)
    hbox_dir.pack_start(btn_dir, True, True, 0)
    hbox_dir.set_sensitive(False)
    vbox_actions.pack_start(hbox_dir, False, False, 0)

    vbox_actions.pack_start(r_open, False, False, 0)

    # Open with combo
    app_store = Gtk.ListStore(str, object)
    apps = Gio.AppInfo.get_all_for_type("image/png")
    for app in apps:
        app_store.append([app.get_display_name(), app])

    combo_open = Gtk.ComboBox.new_with_model(app_store)
    renderer = Gtk.CellRendererText()
    combo_open.pack_start(renderer, True)
    combo_open.add_attribute(renderer, "text", 0)
    if len(app_store) > 0:
        combo_open.set_active(0)
    combo_open.set_margin_start(20)
    combo_open.set_sensitive(False)
    vbox_actions.pack_start(combo_open, False, False, 0)

    def on_toggle(b):
        hbox_dir.set_sensitive(r_save.get_active())
        combo_open.set_sensitive(r_open.get_active())

    r_save.connect("toggled", on_toggle)
    r_open.connect("toggled", on_toggle)
    r_clip.connect("toggled", on_toggle)

    grid.attach(vbox_actions, 0, 0, 1, 1)

    # Preview column
    vbox_prev = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    lbl_prev = Gtk.Label(xalign=0)
    lbl_prev.set_markup(f"<b>{_('Preview')}</b>")
    vbox_prev.pack_start(lbl_prev, False, False, 0)

    try:
        pix = GdkPixbuf.Pixbuf.new_from_file(tmp_img)
        scale = 220.0 / max(pix.get_width(), pix.get_height())
        w = max(1, int(pix.get_width() * min(1.0, scale)))
        h = max(1, int(pix.get_height() * min(1.0, scale)))
        thumb = pix.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)
        img_widget = Gtk.Image.new_from_pixbuf(thumb)
        vbox_prev.pack_start(img_widget, True, True, 0)
    except Exception:
        pass

    grid.attach(vbox_prev, 1, 0, 1, 1)

    dlg.show_all()
    resp = dlg.run()

    chosen_action = "cancel"
    target_folder = btn_dir.get_filename() or save_dir
    selected_app = None
    if resp == Gtk.ResponseType.OK:
        if r_save.get_active():
            chosen_action = "save"
        elif r_open.get_active():
            chosen_action = "open"
            tree_iter = combo_open.get_active_iter()
            if tree_iter:
                selected_app = app_store.get_value(tree_iter, 1)
        else:
            chosen_action = "clip"

    dlg.destroy()

    if chosen_action == "cancel":
        if os.path.exists(tmp_img): os.remove(tmp_img)
        sys.exit(0)

    now_str = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    final_file = os.path.join(target_folder, f"{_('Screenshot')}_{now_str}.png")

    if chosen_action == "save":
        os.replace(tmp_img, final_file)
        if os.path.exists(conf_file):
            try:
                lines = []
                with open(conf_file, "r") as f:
                    for l in f:
                        if l.startswith("screenshot_dir="):
                            lines.append(f"screenshot_dir=file://{target_folder}\n")
                        else:
                            lines.append(l)
                with open(conf_file, "w") as f:
                    f.writelines(lines)
            except Exception:
                pass
    elif chosen_action == "open":
        os.replace(tmp_img, final_file)
        if selected_app:
            files = [Gio.File.new_for_path(final_file)]
            selected_app.launch(files, None)
    elif chosen_action == "clip":
        if os.path.exists(tmp_img): os.remove(tmp_img)

if __name__ == "__main__":
    run()
PYEOF
}

# --- Mode 1: Active Window Capture under mango ---
if [ "$IS_WINDOW" = "true" ] && [ -n "$MANGO_SOCK" ] && command -v mmsg >/dev/null 2>&1; then
    RAW=$(MANGO_INSTANCE_SIGNATURE="$MANGO_SOCK" mmsg get focusing-client 2>/dev/null || true)
    GW=""; GH=""; GX=""; GY=""
    eval $(echo "$RAW" | sed -n 's/.*"x":\([0-9]*\),"y":\([0-9]*\),"width":\([0-9]*\),"height":\([0-9]*\).*/GW=\3 GH=\4 GX=\1 GY=\2/p' 2>/dev/null || true)

    if [ -n "$GW" ] && [ "$GW" -gt 0 ] && [ "$GH" -gt 0 ]; then
        TMP_WIN=$(mktemp /tmp/.screenshot-win.XXXXXX.png)

        if command -v grim >/dev/null 2>&1; then
            grim -g "${GX},${GY} ${GW}x${GH}" "$TMP_WIN" >/dev/null 2>&1 || rm -f "$TMP_WIN"
        fi

        if [ ! -s "$TMP_WIN" ] && command -v convert >/dev/null 2>&1; then
            TMP_FULL=$(mktemp /tmp/.screenshot-full.XXXXXX.png)
            if /usr/bin/xfce4-screenshooter -f -s "$TMP_FULL" >/dev/null 2>&1; then
                convert "$TMP_FULL" -crop "${GW}x${GH}+${GX}+${GY}" +repage "$TMP_WIN"
                rm -f "$TMP_FULL"
            fi
        fi

        if [ -s "$TMP_WIN" ]; then
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy -t image/png < "$TMP_WIN" 2>/dev/null || true
            fi
            show_action_dialog "$TMP_WIN"
            exit 0
        fi
        rm -f "$TMP_WIN"
    fi
fi

# --- Mode 2: Active Monitor Capture (Print key / -f) under mango ---
if [ "$IS_FULLSCREEN" = "true" ] && [ "$IS_REGION" = "false" ] && [ "$IS_WINDOW" = "false" ] && [ -n "$MANGO_SOCK" ] && command -v mmsg >/dev/null 2>&1; then
    RAW_MON=$(MANGO_INSTANCE_SIGNATURE="$MANGO_SOCK" mmsg get all-monitors 2>/dev/null || true)
    MNAME=""; MW=""; MH=""; MX=""; MY=""
    eval $(echo "$RAW_MON" | sed -n 's/.*"name":"\([^"]*\)","active":true[^}]*"x":\([0-9]*\),"y":\([0-9]*\),"width":\([0-9]*\),"height":\([0-9]*\).*/MNAME=\1 MW=\4 MH=\5 MX=\2 MY=\3/p' 2>/dev/null || true)

    if [ -z "$MW" ]; then
        eval $(echo "$RAW_MON" | sed -n 's/.*"name":"\([^"]*\)"[^}]*"x":\([0-9]*\),"y":\([0-9]*\),"width":\([0-9]*\),"height":\([0-9]*\).*/MNAME=\1 MW=\4 MH=\5 MX=\2 MY=\3/p' 2>/dev/null || true)
    fi

    if [ -n "$MW" ] && [ "$MW" -gt 0 ] && [ "$MH" -gt 0 ]; then
        TMP_MON=$(mktemp /tmp/.screenshot-mon.XXXXXX.png)

        if command -v grim >/dev/null 2>&1 && [ -n "$MNAME" ]; then
            grim -o "$MNAME" "$TMP_MON" >/dev/null 2>&1 || rm -f "$TMP_MON"
        fi

        if [ ! -s "$TMP_MON" ] && command -v convert >/dev/null 2>&1; then
            TMP_FULL=$(mktemp /tmp/.screenshot-full.XXXXXX.png)
            if /usr/bin/xfce4-screenshooter -f -s "$TMP_FULL" >/dev/null 2>&1; then
                convert "$TMP_FULL" -crop "${MW}x${MH}+${MX}+${MY}" +repage "$TMP_MON"
                rm -f "$TMP_FULL"
            fi
        fi

        if [ -s "$TMP_MON" ]; then
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy -t image/png < "$TMP_MON" 2>/dev/null || true
            fi
            show_action_dialog "$TMP_MON"
            exit 0
        fi
        rm -f "$TMP_MON"
    fi
fi

# --- Mode 3: Region Selection (-r) ---
if [ "$IS_REGION" = "true" ]; then
    TMP_REG=$(mktemp /tmp/.screenshot-reg.XXXXXX.png)
    if /usr/bin/xfce4-screenshooter -r -s "$TMP_REG" >/dev/null 2>&1 && [ -s "$TMP_REG" ]; then
        if command -v wl-copy >/dev/null 2>&1; then
            wl-copy -t image/png < "$TMP_REG" 2>/dev/null || true
        fi
        show_action_dialog "$TMP_REG"
        exit 0
    fi
    rm -f "$TMP_REG"
    exit 0
fi

# --- Mode 4: Fallback execution if neither of above triggered ---
if [ $# -eq 0 ]; then
    set -- -f
fi

TMP_DEF=$(mktemp /tmp/.screenshot-def.XXXXXX.png)
if /usr/bin/xfce4-screenshooter -s "$TMP_DEF" "$@" >/dev/null 2>&1 && [ -s "$TMP_DEF" ]; then
    if command -v wl-copy >/dev/null 2>&1; then
        wl-copy -t image/png < "$TMP_DEF" 2>/dev/null || true
    fi
    show_action_dialog "$TMP_DEF"
    exit 0
fi
rm -f "$TMP_DEF"

exit 0
