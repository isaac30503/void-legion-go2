#!/bin/sh
# shellcheck disable=SC3043  # "local": dash (Void's /bin/sh) has it
# journalctl — systemd-compat (common/systemd-compat; docs/2-base-system/4-systemd-compat.md): reads the logs that
# exist on this Void instead of a journal:
#   -k / --dmesg                    the kernel's buffer (dmesg; root)
#   -u UNIT (system)                the runit service's svlogd log: log= of units.d, or /var/log/<service>/current
#   --user -u UNIT, --user-unit     the output of an exec or transient unit of systemd-compat
#   -t IDENT                        the svlogd log of the runit service IDENT, or socklog's (if it is installed)
#   nothing selected                socklog's "everything" if it is installed; if not, the kernel's
# Filters: -b (this boot), --since/--until, -p (kernel only: the other logs have no priority), -g (PCRE,
# smart case like journalctl), -n, -r, -o cat, -f. Previous boots are not kept: -b -1 answers like a journal
# without that boot. What it cannot give leaves a line in requests.log ("void-update --systemd").
# shellcheck disable=SC2034  # read by compat.sh
SC_TOOL=journalctl
# shellcheck source=common/systemd-compat/compat.sh
. "${SYSTEMD_COMPAT_LIB:-/usr/local/lib/systemd-compat}/compat.sh"
sc_req "$@"

scope=system kernel=0 units='' uunits='' idents='' prio='' pat='' lines='' since='' until='' output=short boot='' follow=0
reverse=0 quiet=0 list_boots=0 nomatch=
SOCKLOG=${SYSTEMD_COMPAT_SOCKLOG:-/var/log/socklog/everything/current}
refuse() { echo "journalctl: $1" >&2; sc_log unsupported "$1"; exit 1; }
isnum() { case $1 in ''|*[!0-9]*) return 1 ;; esac; return 0; }

while [ $# -gt 0 ]; do
    case $1 in
        --user) scope=user ;;
        --system) scope=system ;;
        -k|--dmesg) kernel=1 ;;
        -b|--boot)   # an optional argument: an offset (0, -1), "all" or a boot id
            boot=0
            case ${2:-} in
                -[0-9]*|all) boot=$2; shift ;;
                *) if isnum "${2:-}"; then boot=$2; shift
                   elif [ ${#2} = 32 ] && ! case $2 in *[!0-9a-f]*) true ;; *) false ;; esac; then boot=$2; shift; fi ;;
            esac ;;
        --boot=*) boot=${1#--boot=} ;;
        -b?*) boot=${1#-b} ;;
        -u|--unit) shift; units="$units ${1:-}" ;;
        --unit=*) units="$units ${1#--unit=}" ;;
        --user-unit) shift; uunits="$uunits ${1:-}" ;;
        --user-unit=*) uunits="$uunits ${1#--user-unit=}" ;;
        -t|--identifier) shift; idents="$idents ${1:-}" ;;
        --identifier=*) idents="$idents ${1#--identifier=}" ;;
        -p|--priority) shift; prio=${1:-} ;;
        --priority=*) prio=${1#--priority=} ;;
        -g|--grep) shift; pat=${1:-} ;;
        --grep=*) pat=${1#--grep=} ;;
        -n|--lines) if isnum "${2:-}"; then lines=$2; shift; else lines=10; fi ;;
        --lines=*) lines=${1#--lines=} ;;
        -n?*) lines=${1#-n} ;;
        -e|--pager-end) lines=${lines:-1000} ;;
        -S|--since) shift; since=${1:-} ;;
        --since=*) since=${1#--since=} ;;
        -U|--until) shift; until=${1:-} ;;
        --until=*) until=${1#--until=} ;;
        -o|--output) shift; output=${1:-short} ;;
        --output=*) output=${1#--output=} ;;
        -f|--follow) follow=1 ;;
        -r|--reverse) reverse=1 ;;
        -q|--quiet) quiet=1 ;;
        --no-pager|-a|--all|-x|--catalog|--no-hostname|--no-full|-l|--full|-m|--merge|--no-tail|--utc) ;;
        --list-boots) list_boots=1 ;;
        --version) echo "systemd-compat $SC_VERSION (runit + elogind; not systemd)"; exit 0 ;;
        -h|--help) echo "journalctl (systemd-compat $SC_VERSION): docs/2-base-system/4-systemd-compat.md of void-legion-go2"; exit 0 ;;
        _SYSTEMD_USER_UNIT=*) uunits="$uunits ${1#*=}" ;;
        _SYSTEMD_UNIT=*|UNIT=*) units="$units ${1#*=}" ;;
        SYSLOG_IDENTIFIER=*) idents="$idents ${1#*=}" ;;
        _TRANSPORT=kernel) kernel=1 ;;
        [A-Z_]*=*) nomatch="$nomatch ${1%%=*}" ;;   # a journal field that does not exist here
        -*) refuse "unrecognized option '$1'" ;;
        *) refuse "unsupported argument '$1'" ;;
    esac
    shift
done
case $output in short*|cat|with-unit|verbose) ;; *) sc_log partial "output $output given as short"; output=short ;; esac

# The boot: only the current one is known (its start = btime of /proc/stat)
btime=0; while read -r k v; do [ "$k" = btime ] && { btime=$v; break; }; done < /proc/stat
read -r bootid < /proc/sys/kernel/random/boot_id; bootid=$(printf '%s' "$bootid" | tr -d -)
if [ $list_boots = 1 ]; then
    printf '%3s %s %s\n' 0 "$bootid" "$(date -d "@$btime" '+%a %Y-%m-%d %H:%M:%S %Z')"; exit 0
fi
case $boot in
    ''|0|all|"$bootid") ;;
    *) echo "Data from the specified boot ($boot) is not available: No such boot ID in journal" >&2
       sc_log partial "boot $boot: previous boots are not kept"; exit 1 ;;
esac

# --since/--until → epoch (journalctl's forms: @N, "YYYY-MM-DD [HH:MM[:SS]]", today, yesterday, now, -1h, -30min…)
epoch() {
    local n
    case $1 in
        '') return 1 ;;
        @*) printf '%s' "${1#@}" ;;
        today) date -d 'today 00:00' +%s ;;
        yesterday) date -d 'yesterday 00:00' +%s ;;
        tomorrow) date -d 'tomorrow 00:00' +%s ;;
        now) date +%s ;;
        [-+][0-9]*)
            n=${1#[-+]}; n=${n%%[a-z]*}
            case $1 in *min|*m) n=$((n * 60)) ;; *h) n=$((n * 3600)) ;; *d) n=$((n * 86400)) ;; *w) n=$((n * 604800)) ;; esac
            case $1 in -*) echo $(( $(date +%s) - n )) ;; *) echo $(( $(date +%s) + n )) ;; esac ;;
        *) date -d "$1" +%s 2>/dev/null ;;
    esac
}
from=; to=
[ -n "$since" ] && { from=$(epoch "$since") || from=; [ -n "$from" ] || refuse "failed to parse timestamp '$since'"; }
[ -n "$until" ] && { to=$(epoch "$until") || to=; [ -n "$to" ] || refuse "failed to parse timestamp '$until'"; }
# The logs on disk span several boots: -b keeps what was written after this one started (the kernel's buffer
# and the units of systemd-compat, in /run, only have this boot anyway)
lfrom=$from
case $boot in ''|all) ;; *) { [ -z "$lfrom" ] || [ "$lfrom" -lt "$btime" ]; } && lfrom=$btime ;; esac
utc() { date -u -d "@$1" +%Y-%m-%d_%H:%M:%S; }

# Sources: "svlogd FILE", "proc FILE", "socklog IDENT", "kernel"
sources=
add() { sources="$sources$*
"; }
missing() { sc_log partial "$1"; }
set -f
for u in $units; do
    sc_norm "$u"; u=$SC_U
    if [ "$scope" = user ]; then sc_resolve user "$u"; else sc_resolve system "$u"; fi
    case $SC_TYPE in
        runit) if [ -r "$SC_LOGFILE" ]; then add svlogd "$SC_LOGFILE"; else missing "unit $u: no readable log ($SC_LOGFILE)"; fi ;;
        proc) [ -r "$SC_DIR/log" ] && add proc "$SC_DIR/log" ;;
        *) missing "unit $u: not found" ;;
    esac
done
for u in $uunits; do
    sc_norm "$u"; sc_resolve user "$SC_U"
    if [ "$SC_TYPE" = proc ]; then [ -r "$SC_DIR/log" ] && add proc "$SC_DIR/log"; else missing "user unit $SC_U: not found"; fi
done
for i in $idents; do
    sc_resolve system "$i"
    if [ "$SC_TYPE" = runit ] && [ -r "$SC_LOGFILE" ]; then add svlogd "$SC_LOGFILE"
    elif [ -r "$SOCKLOG" ]; then add socklog "$i"
    else missing "identifier $i: no log (no runit service with svlogd, no socklog)"; fi
done
set +f
[ $kernel = 1 ] && add kernel
if [ -z "$units$uunits$idents" ] && [ $kernel = 0 ]; then
    if [ -r "$SOCKLOG" ]; then add svlogd "$SOCKLOG"; else add kernel; missing "whole journal: only the kernel's log exists"; fi
fi
[ -n "$nomatch" ] && { missing "fields not in any log here:$nomatch"; sources=; }
[ -n "$prio" ] && [ -n "$units$uunits$idents" ] && missing "priority $prio: only the kernel's log has priorities"

# The kernel's levels for -p ("warning", "4", "err..warning")
levels() {
    local names="emerg alert crit err warn notice info debug" a b i=0 out='' n
    num() { case $1 in emerg|0) echo 0 ;; alert|1) echo 1 ;; crit|2) echo 2 ;; err|3) echo 3 ;; warning|warn|4) echo 4 ;;
                       notice|5) echo 5 ;; info|6) echo 6 ;; debug|7) echo 7 ;; *) echo 7 ;; esac; }
    case $1 in *..*) a=$(num "${1%%..*}"); b=$(num "${1#*..}") ;; *) a=0; b=$(num "$1") ;; esac
    for n in $names; do [ $i -ge "$a" ] && [ $i -le "$b" ] && out="$out${out:+,}$n"; i=$((i + 1)); done
    echo "$out"
}

# One source → its lines, already filtered by time
emit() {   # TYPE ARG
    local s t
    case $1 in
        kernel)
            set -- dmesg
            if [ "$output" = cat ]; then set -- "$@" -t; else set -- "$@" -T; fi
            [ -n "$prio" ] && set -- "$@" --level="$(levels "$prio")"
            [ -n "$from" ] && set -- "$@" --since "@$from"
            [ -n "$to" ] && set -- "$@" --until "@$to"
            [ $follow = 1 ] && set -- "$@" -w
            "$@" 2>/dev/null || missing "kernel: dmesg not readable (root only)" ;;
        svlogd|socklog)
            s=; t=
            [ -n "$lfrom" ] && s=$(utc "$lfrom"); [ -n "$to" ] && t=$(utc "$to")
            if [ "$1" = socklog ]; then f=$SOCKLOG; else f=$2; fi
            if [ $follow = 1 ]; then tail -n "${lines:-10}" -F "$f" 2>/dev/null; return; fi
            awk -v s="$s" -v t="$t" -v cat="$( [ "$output" = cat ] && echo 1)" -v id="$( [ "$1" = socklog ] && printf '%s' "$2")" '
                { ts = substr($1, 1, 19) }
                ts ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}_/ { if (s != "" && ts < s) next; if (t != "" && ts > t) next }
                id != "" && index($0, " " id "[") == 0 && index($0, " " id ":") == 0 { next }
                { if (cat && ts ~ /^[0-9]{4}-/) { sub(/^[^ ]+ /, "") } print }' "$f" ;;
        proc)
            if [ $follow = 1 ]; then tail -n "${lines:-10}" -F "$2" 2>/dev/null | grep --line-buffered -v '^-- start '; return; fi
            # each start of the unit leaves "-- start EPOCH INVOCATION": keep what was written after the time asked
            awk -v s="${from:-0}" -v t="${to:-}" '
                /^-- start / { split($0, a, " "); keep = (a[3] >= s) && (t == "" || a[3] <= t); next }
                keep { print }' "$2" ;;
    esac
}

run() {
    printf '%s' "$sources" | while read -r type arg; do [ -n "$type" ] && emit "$type" "$arg"; done
}
filter() {
    if [ -n "$pat" ]; then
        # journalctl's smart case: case-insensitive unless the pattern has a capital letter
        case $pat in *[A-Z]*) grep -P --line-buffered -- "$pat" ;; *) grep -P -i --line-buffered -- "$pat" ;; esac
    else cat; fi
}
if [ $follow = 1 ]; then run | filter; exit 0; fi
out=$(run | filter)
if [ -n "$lines" ]; then out=$(printf '%s\n' "$out" | tail -n "$lines"); fi
[ $reverse = 1 ] && out=$(printf '%s\n' "$out" | tac)
if [ -n "$out" ]; then printf '%s\n' "$out"
elif [ $quiet = 0 ]; then echo "-- No entries --"; fi
exit 0
