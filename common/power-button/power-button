#!/usr/bin/python3 -IS
# power-button --mode game|desktop — the power button like on the Steam Deck (2026-10-14, the user's request):
#   a short press suspends; held ~3 s, the power menu opens.
#   Game Mode: Steam does both, as with SteamOS's steamos-powerbuttond (steam://shortpowerpress suspends,
#     steam://longpowerpress opens Steam's power menu); without Steam running, a press suspends through elogind.
#   Desktop (Xfce, X11 or Wayland): press → loginctl suspend; held → Xfce's logout dialog (xfce4-session-logout:
#     shut down, restart, suspend, hibernate, log out).
# The Legion Go 2's firmware tells the two apart by itself (captured on 2026-10-14, timed with a stopwatch): a press
# released before ~3 s gives, ON RELEASE, KEY_POWER pressed+released on the ACPI "Power Button"; held ~3 s, the
# embedded controller types Super+F16 on the internal keyboard ("AT Translated Set 2 keyboard", scancodes 0xdb and
# 0x67; the F16 mapping is in Void's hwdb, the same as Valve's) WHILE STILL HELD, and no KEY_POWER at all. So each
# event is one action, with no timing here (the Deck's daemon times 1 s itself; this firmware's ~3 s is fixed).
# Holding much longer powers off in the firmware. On a machine without that F16 (the IdeaPad), a press suspends.
import os, select, signal, struct, sys, time

AFTER_RESUME = 2.0            # seconds after waking up during which presses are ignored
EV_KEY, KEY_POWER, KEY_F16 = 1, 116, 186
EVENT = struct.Struct("llHHi")  # struct input_event (64-bit): time, type, code, value
HOME = os.path.expanduser("~")
RUN = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
PIDFILE = os.path.join(RUN, "power-button.pid")
LOG = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "power-button.log")
STEAM = os.path.join(HOME, ".steam/root/ubuntu12_32/steam")


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > 256 * 1024:
            os.replace(LOG, LOG + ".old")
        with open(LOG, "a") as f:
            f.write(time.strftime("%F %T ") + msg + "\n")
    except OSError:
        pass


def run(*cmd):
    log("run: " + " ".join(cmd))
    try:
        os.posix_spawnp(cmd[0], cmd, os.environ, setsid=True)   # reaped by the kernel (SIGCHLD ignored)
    except OSError as e:
        log(f"failed: {e}")


def steam_running():
    """~/.steam/steam.pid names a live process called steam."""
    try:
        pid = int(open(os.path.join(HOME, ".steam/steam.pid")).read())
        return open(f"/proc/{pid}/comm").read().startswith("steam")
    except (OSError, ValueError):
        return False


def menu(mode):
    if mode == "desktop":
        run("xfce4-session-logout")
    elif steam_running():
        run(STEAM, "-ifrunning", "steam://longpowerpress")
    else:
        log("held without Steam: nothing")


def suspend(mode):
    if mode == "game" and steam_running():
        run(STEAM, "-ifrunning", "steam://shortpowerpress")
    else:
        run("loginctl", "suspend")


def marked_devices():
    """/dev/input/eventN that udev marked: /run/udev/data/c<major>:<minor> has the line E:POWER_BUTTON=1."""
    out = []
    for e in sorted(os.listdir("/dev/input")):
        if not e.startswith("event"):
            continue
        dev = "/dev/input/" + e
        try:
            rdev = os.stat(dev).st_rdev
            with open(f"/run/udev/data/c{os.major(rdev)}:{os.minor(rdev)}") as f:
                if "E:POWER_BUTTON=1\n" in f.read():
                    out.append(dev)
        except OSError:
            pass
    return out


def arm(tfd):
    """The cancel-on-set timer: readable (ECANCELED) when the machine resumes or the clock is set."""
    os.timerfd_settime(tfd, flags=os.TFD_TIMER_ABSTIME | os.TFD_TIMER_CANCEL_ON_SET,
                       initial=time.time() + 10 * 365 * 24 * 3600)


def take_over():
    """Only one per user: the newest session wins (the previous one may be from a session that already ended).
    Never fatal: when switching mode, elogind may remove and recreate $XDG_RUNTIME_DIR just as the session starts
    (2026-10-14: the desktop's one died here, without a word in the log)."""
    try:
        old = int(open(PIDFILE).read())
        if old != os.getpid() and b"power-button" in open(f"/proc/{old}/cmdline", "rb").read():
            os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    for _ in range(50):        # up to 5 s for the runtime folder to be there again
        try:
            with open(PIDFILE, "w") as f:
                f.write(str(os.getpid()))
            return
        except OSError as e:
            err = e
            time.sleep(0.1)
    log(f"pid file not written ({err}): going on without it")


def main():
    args = sys.argv[1:]
    if len(args) != 2 or args[0] != "--mode" or args[1] not in ("game", "desktop"):
        print("usage: power-button --mode game|desktop", file=sys.stderr)
        return 2
    mode = args[1]
    parent = os.getppid()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    take_over()
    buttons = {}
    for dev in marked_devices():
        try:
            buttons[os.open(dev, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)] = dev
        except OSError as e:
            log(f"cannot read {dev}: {e} (reboot after installing: udev gives the access)")
    if not buttons:
        log("no readable power button (POWER_BUTTON=1): exiting")
        return 1
    try:
        session = os.pidfd_open(parent)          # readable when the session's process ends
    except OSError:
        log("the session already ended: exiting")
        return 0
    tfd = os.timerfd_create(time.CLOCK_REALTIME, flags=os.TFD_NONBLOCK | os.TFD_CLOEXEC)
    arm(tfd)
    poller = select.poll()
    for fd in list(buttons) + [session, tfd]:
        poller.register(fd, select.POLLIN)
    log(f"started: mode {mode}, devices {' '.join(buttons.values())}, session pid {parent}")
    ignore_until = 0.0
    while True:
        ready = {fd for fd, _ in poller.poll()}   # no timeout: sleep until something happens
        now = time.monotonic()
        if session in ready:
            log("the session ended: exiting")
            return 0
        if tfd in ready:       # resumed (or the clock was set): handled before the button
            try:
                os.read(tfd, 8)
            except OSError as e:
                if e.errno == 125:   # ECANCELED
                    log(f"resumed or clock set: presses ignored for {AFTER_RESUME:.0f} s")
                    ignore_until = now + AFTER_RESUME
            arm(tfd)
        for fd in buttons:
            if fd not in ready:
                continue
            while True:
                try:
                    data = os.read(fd, EVENT.size * 32)
                except BlockingIOError:
                    break
                if not data:
                    break
                for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _, _, typ, code, value = EVENT.unpack_from(data, i)
                    if typ != EV_KEY or value != 1 or now < ignore_until:
                        continue
                    if code == KEY_POWER:     # a short press, reported on release
                        log("press: suspend")
                        suspend(mode)
                    elif code == KEY_F16:     # held ~3 s (the firmware decides; it comes while still held)
                        log("held: menu")
                        menu(mode)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except BaseException:      # anything unexpected goes to the log (it has no terminal)
        import traceback
        log("crashed:\n" + traceback.format_exc())
        sys.exit(1)
