[Desktop Entry]
Type=Application
Name=Power button
Name[es]=Botón de encendido
Comment=Press: suspend; held ~3 s: power menu (common/power-button)
Comment[es]=Pulsar: suspender; mantener ~3 s: menú de energía (common/power-button)
Exec=/usr/local/bin/power-button --mode desktop
OnlyShowIn=XFCE;
NoDisplay=true
X-XFCE-Autostart-Override=true
