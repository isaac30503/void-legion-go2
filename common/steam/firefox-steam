#!/bin/sh
# Firefox as a "non-Steam game" in Game Mode (gamescope), maximized and without frame
# (2026-10-05, docs/7-apps/3-firefox.md). In Steam: Properties → Shortcut → Target =
# ~/.local/bin/firefox-steam with the full path (install it: install -m 755 firefox-steam ~/.local/bin/).
# Why: in gamescope there is no window manager. With "Title Bar" unchecked (for labwc,
# step 15) Firefox draws its frame itself (client-side decorations, _MOTIF_WM_HINTS without
# decoration) with borders for resizing; the window could be shrunk and there was no way to go back
# to full screen. Here:
#  1. MOZ_GTK_TITLEBAR_DECORATION=system: Firefox does not draw its frame (it asks for the system's, and
#     in gamescope there is none): no border and no resize zones.
#  2. When the window appears (event-driven: xdotool search --sync), it sets it to the size of
#     gamescope's screen (xdotool windowsize 100% 100%, at 0,0).
# Outside gamescope (desktop) it only starts Firefox, without touching anything.
# Previous name: firefox-steam (unchanged).
export MOZ_GTK_TITLEBAR_DECORATION=system
firefox "$@" &
pid=$!
if [ "$XDG_CURRENT_DESKTOP" = gamescope ] && command -v xdotool >/dev/null; then
    # Firefox's main window is the one with a minimum size (WM_NORMAL_HINTS); the others
    # it creates (1×1, 10×10) are auxiliary. --sync waits for a visible one to exist.
    xdotool search --sync --onlyvisible --class firefox >/dev/null 2>&1
    for w in $(xdotool search --class firefox 2>/dev/null); do
        xprop -id "$w" WM_NORMAL_HINTS 2>/dev/null | grep -q 'minimum size' || continue
        xdotool windowsize "$w" 100% 100% windowmove "$w" 0 0 2>/dev/null
    done
fi
wait "$pid"
