# Loaded by /etc/lightdm/Xsession when the graphical session starts.
# ~/.local/bin in the session's PATH: the xdg-terminal-exec that makes
# GTK apps open xterm lives there (fish already has it, but the session does not).
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
# Default terminal for the scripts that look at $TERMINAL
export TERMINAL=xterm
