# local.env.example — copy it to local.env (git-ignored: chmod 600) and put the real values of YOUR
# machines. In the repository those values are written as @NAME@ (see docs/sanitization.md);
# install/render.sh puts them back into build/, and the scripts read the settings below directly.
# Shell syntax (KEY='value'), sourced by lib/common.sh. All values here are made up.
# Keys that no public file uses any more are kept on purpose: verify.sh --secrets searches for every value.

# ---- Private values (the @NAME@ placeholders) --------------------------------------------------
# Home Wi-Fi network name (NetworkManager/iwd profile; recipes and logs)
WIFI_SSID='MyHomeWiFi'
# MACs of the home mesh: the main router and the two nodes (BSSIDs seen by iwd)
MESH_ROUTER_MAC='02:00:00:00:00:01'
MESH_NODE_A_BSSID='02:00:00:00:00:02'
MESH_NODE_B_BSSID='02:00:00:00:00:03'
# Wi-Fi and Bluetooth MACs of the machines
LEGION_WIFI_MAC='02:00:00:00:00:10'
LEGION_BT_MAC='02:00:00:00:00:11'
IDEAPAD_WIFI_MAC='02:00:00:00:00:12'
# Paired Bluetooth devices (headphones, keyboard, mouse, Xbox controller)
HEADPHONES_BT_MAC='02:00:00:00:00:20'
KEYBOARD_BT_MAC='02:00:00:00:00:21'
MOUSE_BT_MAC='02:00:00:00:00:22'
XBOX_CONTROLLER_BT_MAC='02:00:00:00:00:23'
# Filesystem UUIDs (blkid): Legion root (btrfs), swap, EFI (vfat), microSD (ext4); IdeaPad root and EFI;
# EFI partition of the external Kingston XS1000 disk (vfat, the Windows on it)
LEGION_ROOT_UUID='00000000-0000-0000-0000-000000000001'
LEGION_SWAP_UUID='00000000-0000-0000-0000-000000000002'
LEGION_EFI_UUID='0000-0001'
MICROSD_UUID='00000000-0000-0000-0000-000000000003'
IDEAPAD_ROOT_UUID='00000000-0000-0000-0000-000000000004'
IDEAPAD_EFI_UUID='0000-0002'
XS1000_EFI_UUID='0000-0003'
# USB serial numbers that show up in the logs (UGREEN microphone and four other devices)
UGREEN_MIC_SERIAL='SERIAL0000'
USB_SERIAL_1='SERIAL0001'
USB_SERIAL_2='SERIAL0002'
USB_SERIAL_3='SERIAL0003'
USB_SERIAL_4='SERIAL0004'
# Steam account id (the folder under userdata/ and "Steam Controller Configs/")
STEAM_ACCOUNT_ID='12345678'
# Personal e-mail (replaced by the GitHub noreply address in the repository)
PERSONAL_EMAIL='me@example.com'
# The user's full name (void-installer's "User" screen, IdeaPad recipe)
USER_FULL_NAME='Firstname Lastname'
# Id of a Claude Code session quoted in the documents
CLAUDE_SESSION_ID='00000000-0000-0000-0000-000000000000'

# ---- Settings of the machine (not private; read by the scripts) --------------------------------
# Keyboard: X layout and variant, console keymap (Legion: us / intl / us-acentos; IdeaPad: latam / "" / la-latin1)
KEYBOARD_LAYOUT='us'
KEYBOARD_VARIANT='intl'
CONSOLE_KEYMAP='us-acentos'
# Wi-Fi interface (avahi-wifi-only.sh announces only on it; Legion: wlp193s0)
WIFI_INTERFACE='wlp193s0'
# The user the installation is for, when a script runs from a root shell without sudo
TARGET_USER='me'
